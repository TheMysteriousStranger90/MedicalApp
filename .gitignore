# ── Certificates & secrets ───────────────────────────────────────────────────
# Never commit private keys or PFX bundles
certs/
*.pfx
*.key
*.p12
*.pem
# Exception: sample/placeholder certs checked in intentionally can be added with: git add -f

# ── ASP.NET Core Data Protection ─────────────────────────────────────────────
**/DataProtection-Keys/

# ── Serilog rolling-file logs ────────────────────────────────────────────────
src/Medical.GrpcService/Logs/
src/Medical.Client/Logs/

# ── User secrets (local development only) ────────────────────────────────────
**/secrets.json

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose files tracked; ignore override files generated by IDEs
.idea/.idea.*/Docker/docker-compose.generated.override.yml

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Test results & coverage ──────────────────────────────────────────────────
TestResults/
*.trx
*.coveragexml
coverage.json
coverage.cobertura.xml
**/coverage/

# ── Node (if any front-end tooling is added later) ──────────────────────────
node_modules/
npm-debug.log*

src/Medical.GrpcService/appsettings.Production.json
src/Medical.Client/appsettings.Production.json
